# Cloudflare Pages response headers (docs/hosting.md). Copied into dist/ by the build.
# The page, the service worker and the manifest are checked on every visit, so a new version is found at once;
# the files under /assets/ have a hash in their names and never change, so they can be kept for a year.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
